{
  "name": "bb-plugin-task-workspace",
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "bb": ">=0.42",
    "bbPluginSdk": ">=0.4.47"
  },
  "bb": {
    "name": "Task Workspace",
    "description": "Cross-project tasks with durable external memory.",
    "branding": {
      "icon": "ListTodo"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "decode-named-character-reference": "^1.2.0",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "4.1.11",
    "@get-bb/plugin-sdk": "0.4.47"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "bb plugin build",
    "verify": "npm run format:check && npm run check && npm test && npm run build",
    "format": "prettier --write \"*.{ts,tsx,json,md}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"*.{ts,tsx,json,md}\" \"scripts/*.mjs\"",
    "verify:distribution": "node scripts/verify-distribution.mjs"
  },
  "description": "Cross-project tasks with durable external memory.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sof-97/bb-task-plugin-workspace.git"
  },
  "homepage": "https://github.com/Sof-97/bb-task-plugin-workspace#readme",
  "bugs": {
    "url": "https://github.com/Sof-97/bb-task-plugin-workspace/issues"
  },
  "private": true,
  "license": "MIT"
}
